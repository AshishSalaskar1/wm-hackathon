# ============================================================================
# Intelligent Demand-Supply Matching - Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual Azure resource values
# For local development, ensure you're logged in via: az login
# NEVER commit .env or any file containing real credentials.

# ============================================================================
# AZURE OPENAI CONFIGURATION
# ============================================================================

# Azure OpenAI service endpoint (required)
# Format: https://<service-name>.openai.azure.com/
# Example: https://oai-wm-dev-001.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://oai-wm-dev-001.openai.azure.com/

# Embedding model deployment name (required)
# Must match the deployment name in your Azure OpenAI service
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure OpenAI API version (optional, defaults to 2024-02-01)
AZURE_OPENAI_API_VERSION=2024-02-01

# ============================================================================
# AZURE AI SEARCH CONFIGURATION
# ============================================================================

# Azure AI Search service endpoint (required)
# Format: https://<service-name>.search.windows.net
# Example: https://srch-wm-dev-001.search.windows.net
AZURE_SEARCH_ENDPOINT=https://srch-wm-dev-001.search.windows.net

# Supply profiles index name (required)
AZURE_SEARCH_SUPPLY_INDEX=supply-profiles

# Job descriptions index name (required)
AZURE_JD_SEARCH_INDEX_NAME=jd-index

# Vector field name in search index (optional, defaults to content_vector)
AZURE_SEARCH_VECTOR_FIELD=content_vector

# ============================================================================
# RETRIEVAL & MATCHING CONFIGURATION
# ============================================================================

# Retrieval strategy: dense (vector-only) or hybrid (vector + keyword)
# Options: dense | hybrid
RETRIEVAL_STRATEGY=dense

# Number of top results to retrieve from AI Search
RETRIEVAL_TOP_N=10

# Minimum similarity score threshold for demand validation (0-100)
MATCH_DEMAND_THRESHOLD=70.0

# Minimum similarity score threshold for supply matching (0-100)
MATCH_SCORE_THRESHOLD=70

# ============================================================================
# API CONFIGURATION
# ============================================================================

# API server host (defaults to 0.0.0.0)
API_HOST=0.0.0.0

# API server port (defaults to 8000)
API_PORT=8000

# Bypass Azure AD token validation in development
# Set to 'false' for production environments
# When 'true', authentication is skipped for faster local iteration
AUTH_BYPASS_DEV=true

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API URL for the frontend (used by Vite)
VITE_API_URL=http://localhost:8000

# ============================================================================
# AUTHENTICATION SETUP (Local Development)
# ============================================================================
# This application uses Azure CLI-based authentication (DefaultAzureCredential)
# No API keys or connection strings are required when running locally.
#
# Prerequisites:
# 1. Login to Azure CLI:
#    az login
#
# 2. Grant yourself RBAC permissions on the deployed Azure resources:
#
#    # Get your user object ID
#    $userObjectId = az ad signed-in-user show --query id -o tsv
#
#    # Grant Search Index Data Contributor role
#    az role assignment create `
#      --role "Search Index Data Contributor" `
#      --assignee $userObjectId `
#      --scope /subscriptions/<subscription-id>/resourceGroups/rg-wm-dev-001/providers/Microsoft.Search/searchServices/srch-wm-dev-001
#
#    # Grant Cognitive Services OpenAI User role
#    az role assignment create `
#      --role "Cognitive Services OpenAI User" `
#      --assignee $userObjectId `
#      --scope /subscriptions/<subscription-id>/resourceGroups/rg-wm-dev-001/providers/Microsoft.CognitiveServices/accounts/oai-wm-dev-001
#
# 3. Verify your access:
#    az account show
#
# For production deployment, use managed identities or service principals.
# ============================================================================
