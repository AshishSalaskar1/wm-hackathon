# ============================================================
# Environment variables template — copy to .env and fill in.
# NEVER commit .env or any file containing real credentials.
# ============================================================

# --- Azure identity (used by DefaultAzureCredential) ---
# Set these when running locally without managed identity.
# Leave empty in CI/CD; use managed identity or OIDC instead.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure Storage ---
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_SUPPLY_CONTAINER=supply-uploads
AZURE_STORAGE_DEMAND_CONTAINER=demand-uploads

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_SUPPLY_INDEX=supply-profiles
AZURE_SEARCH_JD_INDEX=jd-index

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-02-01

# --- Azure Cosmos DB (Search Result DB) ---
AZURE_COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
AZURE_COSMOS_DATABASE=matching-results
AZURE_COSMOS_CONTAINER=results

# --- Matching engine configuration ---
MATCH_SCORE_THRESHOLD=70
RETRIEVAL_STRATEGY=hybrid    # dense | sparse | hybrid
RETRIEVAL_TOP_N=50

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Set to true to bypass Azure AD token validation in local development (default: true).
# Set to false in staging and production.
AUTH_BYPASS_DEV=true

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# ============================================================
# Local Emulator Overrides — uncomment when running docker compose up
# These values use the well-known public credentials for Azurite and
# the Cosmos DB emulator. They are safe to commit to version control.
# NEVER use these values outside of a local development environment.
# ============================================================

# --- Azure Storage (Azurite emulator — replaces AZURE_STORAGE_ACCOUNT_NAME above) ---
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# --- Azure Cosmos DB (local emulator — replaces AZURE_COSMOS_ENDPOINT above) ---
# AZURE_COSMOS_ENDPOINT=https://localhost:8081
# AZURE_COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b5nOH4Vz/6tZGyw==
# Disable TLS verification for the emulator self-signed certificate (local dev only).
# AZURE_COSMOS_DISABLE_SSL_VERIFY=true
